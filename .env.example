# Django Core
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local development defaults to SQLite)
# On Vercel, set DATABASE_URL to your Supabase PostgreSQL connection string.
# Use Supabase's connection string with SSL enabled (sslmode=require).
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Google Gmail OAuth2 & Pub/Sub (optional - Demo Mode works out of the box)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
GMAIL_PUBSUB_TOPIC=
GMAIL_WEBHOOK_TOKEN=dev-webhook-token

# AI Assistant LLM: set AI_PROVIDER to openai or gemini and provide that provider's API key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
